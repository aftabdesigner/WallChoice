# Copy to .env and fill in. .env is git-ignored.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Include the LAN IP so a phone on the same network can reach the API.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.18.8

# Local development: a zero-configuration SQLite database.
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL example (replace with a public/reachable provider URL):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Media storage.
# True  -> files land in ./media and file_path is built from this server's host.
# False -> files land in R2 (preferred) or legacy Backblaze B2.
USE_LOCAL_MEDIA=True

# Cloudflare R2, via its S3-compatible API. R2_* values take precedence over B2_*.
# Only read when USE_LOCAL_MEDIA=False. R2_REGION defaults to "auto".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
# Examples: https://<account-id>.r2.cloudflarestorage.com
#           https://pub-<bucket-id>.r2.dev

# Legacy Backblaze B2 configuration. Used when no R2_* values are configured.
# B2_ENDPOINT and B2_REGION come from the bucket's "Endpoint" in the B2 console:
# s3.us-west-004.backblazeb2.com -> region us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Optional CDN/custom domain in front of the bucket. Leave blank to serve straight from B2.
B2_CDN_DOMAIN=

# Private bucket mode: every media url is presigned and expires after
# R2_URL_EXPIRE_SECONDS, so copied links stop working. Make the bucket private
# in Cloudflare when turning this on. Leave False to serve the public domain.
R2_SIGNED_URLS=False
R2_URL_EXPIRE_SECONDS=21600

# --- Performance ----------------------------------------------------------
# API responses are cached and invalidated automatically on every admin change.
# REDIS_URL shares that cache between workers/replicas (optional; without it
# each process keeps its own cache, which is still correct).
REDIS_URL=
API_CACHE_SECONDS=300
API_CLIENT_MAX_AGE=300
DB_CONN_MAX_AGE=60
# Gunicorn (Dockerfile): WEB_CONCURRENCY=2 workers, GUNICORN_THREADS=4 threads.
# Trending is rebuilt from the last 7 days at most this often (minutes),
# triggered by incoming events, in a background thread.
SCORES_RECALC_MINUTES=10
SCORES_RECALC_ASYNC=True

# --- Production (Railway) ------------------------------------------------
# These are NOT read from this file in production. Railway has no .env: set each
# one under Service -> Variables. Listed here so the full set is in one place.
#
#   SECRET_KEY            a fresh long random string, never the local one
#                         python -c "import secrets; print(secrets.token_urlsafe(64))"
#   DEBUG                 False
#   ALLOWED_HOSTS         your custom domain, comma separated. The Railway
#                         domain and its health-check host are added
#                         automatically from RAILWAY_PUBLIC_DOMAIN, so this can
#                         be left unset if you only use the *.up.railway.app url.
#   CSRF_TRUSTED_ORIGINS  https://your-custom-domain.com  (scheme required).
#                         The Railway domain is added automatically.
#   DATABASE_URL          reference Railway's Postgres, do not paste a literal:
#                         ${{ Postgres.DATABASE_URL }}
#   USE_LOCAL_MEDIA       False. Railway's filesystem is ephemeral - anything
#                         uploaded through the admin is lost on the next deploy,
#                         so production must store media in public object storage.
#   R2_ACCOUNT_ID         Cloudflare account ID
#   R2_ACCESS_KEY_ID      R2 S3 API access key ID
#   R2_SECRET_ACCESS_KEY  R2 S3 API secret access key
#   R2_BUCKET_NAME        R2 bucket name
#   R2_ENDPOINT_URL       https://<account-id>.r2.cloudflarestorage.com
#   R2_PUBLIC_BASE_URL    HTTPS public bucket URL (for example, an r2.dev domain)
#   Alternatively, use the legacy B2_* settings above.
#
# RAILWAY_PUBLIC_DOMAIN and PORT are injected by Railway. Do not set them.
